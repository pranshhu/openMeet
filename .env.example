# openMeet environment variables. Copy what you need; nothing here is required
# for local development, which works with the defaults.

# ---------------------------------------------------------------------------
# Web (apps/web/.env.local)
# ---------------------------------------------------------------------------

# Origin of the Worker API. Defaults to http://localhost:8787 in dev.
#
# IMPORTANT: this is baked into the bundle at BUILD time, not read at runtime.
# If the Worker URL changes you must rebuild and redeploy the web app.
NEXT_PUBLIC_API_BASE=http://localhost:8787

# ---------------------------------------------------------------------------
# Worker (apps/worker/wrangler.toml [vars], or .dev.vars for local secrets)
# ---------------------------------------------------------------------------

# The single origin allowed by CORS. Must exactly match where the web app is
# served from -- CORS headers are emitted only for this origin.
PAGES_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# TURN (optional -- Worker secrets, set via `wrangler secret put`)
# ---------------------------------------------------------------------------
#
# Static TURN wins, then the Cloudflare mint, then the STUN-only stub.
# Without static TURN or BOTH Cloudflare credentials, the Worker serves a
# STUN-only stub. Calls still connect on the same network or behind cone NAT,
# but two peers behind symmetric NAT on different networks CANNOT connect --
# there is no relay candidate.
#
# Self-hosted / static TURN (takes precedence over Cloudflare mint):
# TURN_URLS is a comma-separated list of turn: and/or turns: URIs.
# Username and credential may be omitted for STUN-only or unauthenticated TURN.
#
#   printf %s 'turn:turn.example.org:3478,turns:turn.example.org:5349' | wrangler secret put TURN_URLS
#   printf %s '<USERNAME>'   | wrangler secret put TURN_USERNAME
#   printf %s '<CREDENTIAL>' | wrangler secret put TURN_CREDENTIAL
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Cloudflare Realtime TURN (minted on demand if static TURN is not configured):
# Create a key at: Cloudflare Dashboard -> Realtime -> TURN -> Create key
#
#   printf %s '<TURN_TOKEN_ID>' | wrangler secret put TURN_APP_ID
#   printf %s '<API_TOKEN>'     | wrangler secret put TURN_API_TOKEN
#
# Never commit real values. Secrets apply immediately -- no redeploy needed.
TURN_APP_ID=
TURN_API_TOKEN=
