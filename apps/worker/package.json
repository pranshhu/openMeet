{
  "name": "@openmeet/worker",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --var PAGES_ORIGIN:http://localhost:3000",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply openmeet_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply openmeet_db --remote"
  },
  "dependencies": {
    "@openmeet/protocol": "workspace:*",
    "hono": "^4.6.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.30",
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^3.86.0"
  }
}
